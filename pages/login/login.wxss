/* ===== 登录页 ===== */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(160deg, #E8F5E9 0%, #F0FDF4 30%, #FFFFFF 60%);
  padding: 0 60rpx;
  position: relative;
  overflow: hidden;
}

/* ===== 装饰圆 ===== */
.decoration { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}
.deco-1 {
  width: 500rpx; height: 500rpx;
  background: #4CAF50;
  top: -120rpx; right: -100rpx;
}
.deco-2 {
  width: 300rpx; height: 300rpx;
  background: #66BB6A;
  bottom: 200rpx; left: -80rpx;
}
.deco-3 {
  width: 200rpx; height: 200rpx;
  background: #81C784;
  top: 300rpx; left: 40rpx;
}

/* ===== 品牌展示 ===== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
}
.brand-icon-wrap {
  width: 160rpx; height: 160rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(76, 175, 80, 0.35);
}
.brand-icon { font-size: 72rpx; }
.brand-title {
  font-size: 44rpx; font-weight: 700; color: #1A2332;
  margin-bottom: 16rpx;
}
.brand-subtitle {
  font-size: 26rpx; color: #94A3B8;
}

/* ===== 登录区域 ===== */
.login-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(76, 175, 80, 0.35);
  border: none;
}
.login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
.login-tips {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.tip-item {
  font-size: 22rpx;
  color: #94A3B8;
  background: rgba(255,255,255,0.8);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.agreement-text {
  font-size: 22rpx;
  color: #CBD5E0;
  margin-top: 32rpx;
}
