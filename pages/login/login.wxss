/* ===== 登录页 - 白色清新风 ===== */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(160deg, #F5F7FA 0%, #FFFFFF 40%, #F0F4F8 100%);
  padding: 0 60rpx;
  position: relative;
  overflow: hidden;
}

/* ===== 装饰圆 ===== */
.decoration { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.06;
  filter: blur(40rpx);
}
.deco-1 {
  width: 500rpx; height: 500rpx;
  background: #4CAF50;
  top: -120rpx; right: -100rpx;
}
.deco-2 {
  width: 300rpx; height: 300rpx;
  background: #2196F3;
  bottom: 200rpx; left: -80rpx;
}
.deco-3 {
  width: 200rpx; height: 200rpx;
  background: #4CAF50;
  top: 300rpx; left: 40rpx;
}

/* ===== 品牌展示 ===== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
}
.brand-icon-wrap {
  width: 160rpx; height: 160rpx;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(76, 175, 80, 0.25);
  position: relative;
  overflow: hidden;
}
.brand-icon-wrap::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  filter: blur(10rpx);
}
.brand-icon { font-size: 72rpx; position: relative; }
.brand-title {
  font-size: 44rpx; font-weight: 700; color: #2C3E50;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.brand-subtitle {
  font-size: 26rpx; color: #95A5A6;
}

/* ===== 登录区域 ===== */
.login-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.25);
  border: none;
  transition: all 0.3s ease;
}
.login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
.login-tips {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.tip-item {
  font-size: 22rpx;
  color: #95A5A6;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF0;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}
.agreement-text {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 32rpx;
}
