<view class="page-container">
  <view class="analysis-header">
    <view class="device-bar" bindtap="handleSwitchDevice">
      <view class="device-bar-inner">
        <view class="device-info">
          <view class="device-icon">📡</view>
          <view>
            <view class="device-name">{{currentDeviceName || '请选择设备'}}</view>
          </view>
        </view>
        <view class="device-arrow">›</view>
      </view>
    </view>
    <view class="time-tabs">
      <view wx:for="{{timeOptions}}" wx:key="value"
        class="time-tab {{hours === item.value ? 'time-tab-active' : ''}}"
        bindtap="switchHours" data-hours="{{item.value}}">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{!currentDeviceId}}" class="empty-state">
    <view class="empty-icon">📊</view>
    <view class="empty-text">请先选择设备</view>
  </view>

  <block wx:else>
    <view class="summary-row">
      <view class="summary-card" style="background:linear-gradient(135deg,#4CAF50,#66BB6A);">
        <view class="summary-label">平均 AQI</view>
        <view class="summary-value">{{summary.avgAqi}}</view>
        <view class="summary-desc">{{summary.date}}</view>
      </view>
      <view class="summary-card" style="background:linear-gradient(135deg,#FF9800,#FFA726);">
        <view class="summary-label">最高 AQI</view>
        <view class="summary-value">{{summary.maxAqi}}</view>
        <view class="summary-desc">今日峰值</view>
      </view>
      <view class="summary-card" style="background:linear-gradient(135deg,#2196F3,#42A5F5);">
        <view class="summary-label">平均 PM2.5</view>
        <view class="summary-value">{{summary.avgPm25}}</view>
        <view class="summary-desc">μg/m³</view>
      </view>
    </view>

    <!-- 折线图 -->
    <view class="chart-card">
      <view class="section-title">
        <text>📈 趋势图表</text>
        <text class="section-badge">最近{{hours}}小时</text>
      </view>

      <view wx:if="{{historyList.length === 0}}" class="empty-mini">暂无历史数据</view>

      <view wx:else class="chart-wrapper">
        <view class="chart-legend">
          <view class="legend-item"><view class="legend-dot legend-aqi"></view><text>AQI</text></view>
          <view class="legend-item"><view class="legend-dot legend-pm"></view><text>PM2.5</text></view>
          <view class="legend-item"><view class="legend-dot legend-no2"></view><text>NO₂</text></view>
        </view>
        <canvas canvas-id="trendChart" id="trendChart"
          class="chart-canvas"
          style="width: {{chartWidth}}px; height: {{chartHeight}}px;"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"></canvas>
        <view wx:if="{{tooltip.show}}" class="tooltip-box" style="left: {{tooltip.x}}px; top: {{tooltip.y}}px;">
          <view class="tooltip-time">{{tooltip.time}}</view>
          <view class="tooltip-row tooltip-aqi">AQI: {{tooltip.aqi}}</view>
          <view class="tooltip-row tooltip-pm">PM2.5: {{tooltip.pm}}</view>
          <view class="tooltip-row tooltip-no2">NO₂: {{tooltip.no2}}</view>
        </view>
      </view>

      <view class="chart-actions" wx:if="{{historyList.length > 0}}">
        <view class="chart-action-btn" bindtap="exportChart">
          <text>📷 导出图片</text>
        </view>
        <view class="chart-action-btn" bindtap="shareChart">
          <text>🔗 分享</text>
        </view>
      </view>
    </view>

    <!-- AI 分析卡片 -->
    <view class="chart-card" style="margin-top: 20rpx;">
      <view class="section-title">
        <text>🧠 AI 空气质量分析</text>
      </view>
      <view style="margin-top: 20rpx;">
        <button class="ai-btn {{aiLoading ? 'ai-btn-loading' : ''}}"
          bindtap="loadAIAnalysis" disabled="{{aiLoading}}">
          <text wx:if="{{!aiLoading}}">🤖 开始分析</text>
          <text wx:else>⏳ 分析中...</text>
        </button>
      </view>
      <view wx:if="{{aiShow && !aiLoading && aiResult}}" class="ai-result-box">
        <view class="ai-result-text">{{aiResult}}</view>
        <view class="ai-result-close" bindtap="closeAI">收起</view>
      </view>
      <view wx:if="{{aiError}}" class="ai-error">{{aiError}}</view>
    </view>
  </block>

  <view wx:if="{{showDevicePicker}}" class="picker-mask" bindtap="closePicker">
    <view class="picker-content" catchtap="noop">
      <view class="picker-title">选择设备</view>
      <scroll-view scroll-y class="picker-list">
        <view wx:for="{{deviceList}}" wx:key="device_id"
          class="picker-item {{item.device_id === currentDeviceId ? 'picker-item-active' : ''}}"
          bindtap="selectDevice" data-index="{{index}}">
          <view class="picker-item-left">
            <view class="picker-dot {{item.status === 1 || item.status === 'online' ? 'dot-online' : 'dot-offline'}}"></view>
            <text>{{item.device_name || item.device_id}}</text>
          </view>
          <text wx:if="{{item.device_id === currentDeviceId}}" class="check-mark">✓</text>
        </view>
        <view wx:if="{{deviceList.length === 0}}" class="picker-empty">暂无设备</view>
      </scroll-view>
      <view class="picker-close" bindtap="closePicker">取消</view>
    </view>
  </view>
</view>