/* ===== 分析页 - 白色清新风 ===== */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F7FA 0%, #FFFFFF 50%, #F0F4F8 100%);
  position: relative;
  overflow: hidden;
  padding-bottom: 40rpx;
}

/* 顶部背景 */
.page-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(76,175,80,0.06) 0%, transparent 100%);
  pointer-events: none;
}

/* ===== 顶部栏 ===== */
.analysis-header { margin: 40rpx 32rpx 0; position: relative; z-index: 2; }
.device-bar {
  background: #FFFFFF;
  border: 1rpx solid #E8ECF0;
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.device-bar:active { background: #F8F9FA; }
.device-bar-inner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx;
}
.device-info { display: flex; align-items: center; gap: 16rpx; }
.device-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.2);
}
.device-name {
  font-size: 30rpx; font-weight: 600; color: #2C3E50;
  max-width: 260rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.device-arrow { font-size: 36rpx; color: #DCDFE6; font-weight: 300; }

/* ===== 时间标签 ===== */
.time-tabs {
  display: flex; gap: 12rpx;
  margin-top: 20rpx;
  justify-content: center;
}
.time-tab {
  font-size: 24rpx; color: #7F8C8D;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF0;
  transition: all 0.2s;
}
.time-tab-active {
  color: #fff;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.25);
  border: none;
}

/* ===== 统计三卡片 ===== */
.summary-row {
  display: flex; gap: 16rpx;
  margin: 24rpx 32rpx 0;
  position: relative;
  z-index: 2;
}
.summary-card {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex; flex-direction: column; align-items: center;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.summary-card::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  filter: blur(10rpx);
}
.summary-label { font-size: 20rpx; opacity: 0.95; margin-bottom: 8rpx; position: relative; }
.summary-value { font-size: 44rpx; font-weight: 700; position: relative; }
.summary-desc { font-size: 18rpx; opacity: 0.85; margin-top: 4rpx; position: relative; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  position: relative;
}
.empty-state::before {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(76,175,80,0.06) 0%, transparent 70%);
  border-radius: 50%;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; position: relative; opacity: 0.6; }
.empty-text { font-size: 30rpx; color: #5D6D7E; position: relative; }

.empty-mini { text-align: center; color: #BDC3C7; padding: 60rpx 0; font-size: 26rpx; }

/* ===== 分区标题 ===== */
.section-title {
  font-size: 28rpx; font-weight: 700; color: #2C3E50;
  display: flex; align-items: center; gap: 12rpx;
}
.section-badge {
  font-size: 20rpx; font-weight: 400;
  color: #7F8C8D;
  background: #F5F7FA;
  padding: 4rpx 16rpx; border-radius: 20rpx;
  border: 1rpx solid #E8ECF0;
}

/* ===== 折线图 ===== */
.chart-card {
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF0;
  border-radius: 24rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.chart-wrapper {
  position: relative;
  margin-top: 20rpx;
}

.chart-legend {
  display: flex;
  gap: 28rpx;
  justify-content: center;
  margin-bottom: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #7F8C8D;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-aqi { background: #FF5722; }
.legend-pm { background: #2196F3; }
.legend-no2 { background: #9C27B0; }

.chart-canvas {
  width: 100%;
}

.tooltip-box {
  position: absolute;
  background: rgba(44,62,80,0.92);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  z-index: 10;
  pointer-events: none;
  min-width: 160rpx;
}

.tooltip-time {
  font-size: 20rpx;
  color: #BDC3C7;
  margin-bottom: 6rpx;
}

.tooltip-row {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.5;
}

.tooltip-aqi { color: #FF5722; }
.tooltip-pm { color: #64B5F6; }
.tooltip-no2 { color: #CE93D8; }

.chart-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  justify-content: flex-end;
}

.chart-action-btn {
  padding: 12rpx 24rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #7F8C8D;
  border: 1rpx solid #E8ECF0;
  transition: all 0.2s;
}

.chart-action-btn:active {
  background: #E8ECF0;
}

/* ===== AI 分析 ===== */
.ai-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  border: none;
  transition: all 0.3s;
}

.ai-btn:active { transform: scale(0.97); opacity: 0.9; }
.ai-btn-loading { opacity: 0.7; }

.ai-result-box {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #F8F9FE;
  border-radius: 20rpx;
  border: 1rpx solid #E8ECF0;
  position: relative;
}

.ai-result-text {
  font-size: 26rpx;
  color: #2C3E50;
  line-height: 1.8;
  white-space: pre-wrap;
}

.ai-result-close {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #95A5A6;
  padding: 10rpx 0;
}

.ai-error {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #FFF0F0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #E74C3C;
  text-align: center;
}

/* ===== 弹窗 ===== */
.picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex; justify-content: center; align-items: flex-end;
  z-index: 100;
}
.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 0 60rpx;
  max-height: 520rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
}
.picker-title {
  text-align: center; font-size: 32rpx; font-weight: 700; color: #2C3E50;
  padding-bottom: 24rpx;
}
.picker-list { max-height: 320rpx; }
.picker-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 40rpx; font-size: 30rpx;
  transition: all 0.2s;
}
.picker-item-active { background: rgba(76,175,80,0.08); }
.picker-item-left { display: flex; align-items: center; gap: 16rpx; }
.picker-item-left text { color: #2C3E50; }
.picker-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot-online { background: #4CAF50; box-shadow: 0 0 8rpx rgba(76,175,80,0.4); }
.dot-offline { background: #BDC3C7; }
.check-mark {
  color: #4CAF50; font-weight: 700; font-size: 32rpx;
}
.picker-empty { text-align: center; color: #95A5A6; padding: 40rpx; }
.picker-close {
  text-align: center; padding: 24rpx 0 0;
  font-size: 28rpx; color: #95A5A6;
  border-top: 1rpx solid #ECF0F1; margin: 0 40rpx;
}
