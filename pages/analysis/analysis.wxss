/* ===== 分析页 ===== */
.page-container { padding-bottom: 40rpx; }

/* ===== 顶部栏 ===== */
.analysis-header { margin: 16rpx 20rpx 0; }
.device-bar {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.device-bar-inner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx;
}
.device-info { display: flex; align-items: center; gap: 12rpx; }
.device-icon { font-size: 36rpx; }
.device-name {
  font-size: 30rpx; font-weight: 600; color: #1A2332;
  max-width: 260rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.device-arrow { font-size: 40rpx; color: #CBD5E0; font-weight: 300; }

/* ===== 时间标签 ===== */
.time-tabs {
  display: flex; gap: 12rpx;
  margin-top: 16rpx;
  justify-content: center;
}
.time-tab {
  font-size: 24rpx; color: #94A3B8;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}
.time-tab-active {
  color: #fff;
  background: linear-gradient(135deg, #4CAF50, #43A047);
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.3);
}

/* ===== 统计三卡片 ===== */
.summary-row {
  display: flex; gap: 16rpx;
  margin: 20rpx 20rpx 0;
}
.summary-card {
  flex: 1;
  border-radius: 18rpx;
  padding: 24rpx 16rpx;
  display: flex; flex-direction: column; align-items: center;
  color: #fff;
}
.summary-label { font-size: 20rpx; opacity: 0.9; margin-bottom: 8rpx; }
.summary-value { font-size: 44rpx; font-weight: 700; }
.summary-desc { font-size: 18rpx; opacity: 0.7; margin-top: 4rpx; }

/* ===== 空状态 ===== */
.empty-mini { text-align: center; color: #CBD5E0; padding: 60rpx 0; font-size: 26rpx; }

/* ===== 分区标题 ===== */
.section-title {
  font-size: 28rpx; font-weight: 700; color: #1A2332;
  display: flex; align-items: center; gap: 12rpx;
}
.section-badge {
  font-size: 20rpx; font-weight: 400;
  color: #94A3B8; background: #F0F4F3;
  padding: 4rpx 16rpx; border-radius: 20rpx;
}

/* ===== 历史数据表格 ===== */
.history-card { padding: 28rpx; }
.history-table { margin-top: 20rpx; }
.table-header {
  display: flex;
  padding: 16rpx 0; margin-bottom: 4rpx;
  border-bottom: 2rpx solid #E8ECF0;
  font-size: 24rpx; color: #94A3B8; font-weight: 600;
}
.table-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F4F3;
  align-items: center;
  font-size: 26rpx; color: #1A2332;
}
.table-row:last-child { border-bottom: none; }
.col-time { flex: 3; color: #64748B; }
.col-aqi  { flex: 2; display: flex; align-items: center; gap: 6rpx; font-weight: 600; }
.col-pm   { flex: 2; }
.aqi-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0;
}

/* ===== 弹窗 ===== */
.picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; justify-content: center; align-items: flex-end;
  z-index: 100;
}
.picker-content {
  width: 100%; background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 0 60rpx;
  max-height: 520rpx;
}
.picker-title {
  text-align: center; font-size: 32rpx; font-weight: 700; color: #1A2332;
  padding-bottom: 24rpx; border-bottom: 1rpx solid #F0F4F3;
}
.picker-list { max-height: 320rpx; }
.picker-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 40rpx; font-size: 30rpx;
}
.picker-item-active { background: #F0FDF4; }
.picker-item-left { display: flex; align-items: center; gap: 16rpx; }
.picker-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot-online { background: #4CAF50; box-shadow: 0 0 6rpx rgba(76,175,80,0.5); }
.dot-offline { background: #CBD5E0; }
.check-mark {
  color: #4CAF50; font-weight: 700; font-size: 36rpx;
  width: 44rpx; height: 44rpx;
  background: #F0FDF4; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.picker-empty { text-align: center; color: #94A3B8; padding: 40rpx; }
.picker-close {
  text-align: center; padding: 24rpx 0 0;
  font-size: 28rpx; color: #94A3B8;
  border-top: 1rpx solid #F0F4F3; margin: 0 40rpx;
}
