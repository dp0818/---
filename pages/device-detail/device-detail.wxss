/* ===== 设备详情页 ===== */
.page-container { padding-bottom: 60rpx; }

/* ===== 设备头部 ===== */
.detail-header-card {
  margin: 16rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.detail-header-top {
  display: flex; justify-content: space-between; align-items: flex-start;
}
.detail-header-left { display: flex; align-items: center; gap: 16rpx; }
.detail-device-icon { font-size: 44rpx; }
.detail-device-name { font-size: 36rpx; font-weight: 700; color: #1A2332; }
.detail-device-id { font-size: 24rpx; color: #94A3B8; margin-top: 4rpx; }

/* ===== 收藏按钮 ===== */
.favorite-btn {
  display: flex; flex-direction: column; align-items: center;
  padding: 8rpx 16rpx;
  background: #FFF8E1;
  border-radius: 14rpx;
  min-width: 80rpx;
}
.favorite-star { font-size: 36rpx; }
.favorite-star.is-favorited { color: #FF9800; }
.favorite-text { font-size: 20rpx; color: #94A3B8; margin-top: 2rpx; }

/* ===== 状态栏 ===== */
.detail-status-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 20rpx; padding-top: 16rpx;
  border-top: 1rpx solid #F0F4F3;
}
.status-tag {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx; padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.status-online { background: #F0FDF4; color: #4CAF50; }
.status-offline { background: #F1F5F9; color: #94A3B8; }
.badge-active {
  font-size: 22rpx; color: #4CAF50;
  background: #F0FDF4; padding: 4rpx 14rpx;
  border-radius: 20rpx; font-weight: 500;
}
.battery-tag {
  margin-left: auto;
  font-size: 22rpx; color: #64748B;
  background: #F0F4F3; padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* ===== 通用内容卡片 ===== */
.detail-card {
  margin: 16rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.detail-section-title {
  font-size: 28rpx; font-weight: 700; color: #1A2332;
  margin-bottom: 20rpx;
}

/* ===== 信息网格 ===== */
.info-grid { display: flex; gap: 20rpx; }
.info-item {
  flex: 1;
  background: #F8FAFC;
  border-radius: 14rpx;
  padding: 16rpx;
  display: flex; flex-direction: column; align-items: center;
}
.info-label { font-size: 22rpx; color: #94A3B8; margin-bottom: 6rpx; }
.info-value { font-size: 28rpx; color: #1A2332; font-weight: 600; }

/* ===== 按钮 ===== */
.btn-action {
  width: 100%; height: 76rpx; line-height: 76rpx;
  text-align: center; border-radius: 38rpx;
  font-size: 28rpx; font-weight: 500; margin-top: 16rpx;
  padding: 0; border: none;
}
.btn-action-location {
  background: linear-gradient(135deg, #2196F3, #42A5F5);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(33,150,243,0.25);
}
.btn-action-default {
  background: #F0F4F3;
  color: #64748B;
}

/* ===== 告警设置 ===== */
.alert-row {
  display: flex; align-items: center; gap: 0;
  background: #FFF8E1;
  border-radius: 14rpx;
  padding: 20rpx;
}
.alert-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
}
.alert-value {
  font-size: 44rpx; font-weight: 700;
  color: #F44336;
}
.alert-unit {
  font-size: 20rpx; color: #94A3B8;
  margin-top: 4rpx;
}
.alert-divider {
  width: 2rpx; height: 48rpx;
  background: #FFE082;
}

/* ===== 操作按钮区 ===== */
.action-area {
  padding: 40rpx 20rpx 20rpx;
  display: flex; flex-direction: column; gap: 20rpx;
}
.action-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  text-align: center; border-radius: 44rpx;
  font-size: 30rpx; font-weight: 600;
  border: none; padding: 0;
}
.action-btn-primary {
  background: linear-gradient(135deg, #4CAF50, #43A047);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.3);
}
.action-btn-danger {
  background: #fff;
  color: #F44336;
  border: 2rpx solid #FFCDD2;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; justify-content: center; align-items: center;
  z-index: 100;
}
.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}
.modal-title {
  font-size: 34rpx; font-weight: 700;
  text-align: center; margin-bottom: 32rpx;
  color: #1A2332;
}
.modal-field { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; color: #64748B; display: block; margin-bottom: 10rpx; }
.field-input {
  width: 100%; height: 76rpx;
  border: 2rpx solid #E8ECF0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #F8FAFC;
}
.field-input:focus {
  border-color: #4CAF50;
}
.modal-btns { display: flex; gap: 16rpx; margin-top: 32rpx; }
.modal-btn {
  flex: 1; height: 76rpx; line-height: 76rpx;
  text-align: center; border-radius: 38rpx;
  font-size: 28rpx; font-weight: 500;
  border: none; padding: 0;
}
.modal-btn-cancel { background: #F0F4F3; color: #64748B; }
.modal-btn-confirm { background: linear-gradient(135deg, #4CAF50, #43A047); color: #fff; }
