<view class="page-container">

  <!-- 顶部设备切换栏 -->
  <view class="device-bar" bindtap="handleSwitchDevice">
    <view class="device-bar-inner">
      <view class="device-info">
        <view class="device-icon">📡</view>
        <view>
          <view class="device-name">{{currentDeviceName || '请选择设备'}}</view>
          <view class="device-meta">
            <text wx:if="{{battery !== '--'}}">🔋 {{battery}}%</text>
            <text wx:if="{{signal !== '--'}}" style="margin-left: 16rpx;">📶 {{signal}}dBm</text>
          </view>
        </view>
      </view>
      <view class="device-arrow">
        <view class="arrow-icon">›</view>
      </view>
    </view>
  </view>

  <!-- 无设备空状态 -->
  <view wx:if="{{!currentDeviceId}}" class="empty-state">
    <view class="empty-icon">🌤️</view>
    <view class="empty-text">暂无绑定设备</view>
    <view class="empty-hint">请前往"设备"页面扫码或输入ID绑定</view>
  </view>

  <!-- 有设备时展示数据 -->
  <block wx:else>
    <!-- AQI 大卡片 -->
    <view class="aqi-card {{bgClass}}">
      <view class="aqi-label">空气质量指数 (AQI)</view>
      <view class="aqi-value">{{aqi}}</view>
      <view class="aqi-level-row">
        <view class="aqi-level-tag">{{levelText}}</view>
        <view class="aqi-update">更新于 {{sampleTime}}</view>
      </view>
    </view>

    <!-- 污染物网格 -->
    <view class="pollutant-grid">
      <view class="grid-item">
        <view class="grid-icon" style="background:#E8F5E9;">🌫️</view>
        <view class="grid-label">PM2.5</view>
        <view class="grid-value">{{pm2_5}} <text class="grid-unit">μg/m³</text></view>
      </view>
      <view class="grid-item">
        <view class="grid-icon" style="background:#E3F2FD;">🧪</view>
        <view class="grid-label">NO₂</view>
        <view class="grid-value">{{no2}} <text class="grid-unit">mg/m³</text></view>
      </view>
      <view class="grid-item">
        <view class="grid-icon" style="background:#F3E5F5;">☁️</view>
        <view class="grid-label">SO₂</view>
        <view class="grid-value">{{so2}} <text class="grid-unit">mg/m³</text></view>
      </view>
      <view class="grid-item">
        <view class="grid-icon" style="background:#E0F7FA;">☀️</view>
        <view class="grid-label">O₃</view>
        <view class="grid-value">{{o3}} <text class="grid-unit">mg/m³</text></view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="goAnalysis">
        <view class="action-icon" style="background:linear-gradient(135deg,#4CAF50,#66BB6A);">📊</view>
        <view class="action-text">历史分析</view>
      </view>
      <view class="action-item" bindtap="goMap">
        <view class="action-icon" style="background:linear-gradient(135deg,#2196F3,#42A5F5);">🗺️</view>
        <view class="action-text">地图查看</view>
      </view>
      <view class="action-item" bindtap="goDetail">
        <view class="action-icon" style="background:linear-gradient(135deg,#78909C,#90A4AE);">⚙️</view>
        <view class="action-text">设备详情</view>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </block>

  <!-- 设备选择弹窗 -->
  <view wx:if="{{showDevicePicker}}" class="picker-mask" bindtap="closePicker">
    <view class="picker-content" catchtap="noop">
      <view class="picker-title">选择设备</view>
      <scroll-view scroll-y class="picker-list">
        <view
          wx:for="{{deviceList}}" wx:key="device_id"
          class="picker-item {{item.device_id === currentDeviceId ? 'picker-item-active' : ''}}"
          bindtap="selectDevice" data-index="{{index}}"
        >
          <view class="picker-item-left">
            <view class="picker-dot {{item.status === 1 ? 'dot-online' : 'dot-offline'}}"></view>
            <text>{{item.device_name || item.device_id}}</text>
          </view>
          <text wx:if="{{item.device_id === currentDeviceId}}" class="check-mark">✓</text>
        </view>
        <view wx:if="{{deviceList.length === 0}}" class="picker-empty">暂无设备</view>
      </scroll-view>
      <view class="picker-close" bindtap="closePicker">取消</view>
    </view>
  </view>
</view>
