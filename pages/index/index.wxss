/* ===== 首页样式 ===== */
.page-container { padding-bottom: 40rpx; }

/* ===== 顶部设备切换栏 ===== */
.device-bar {
  margin: 16rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.device-bar-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}
.device-info { display: flex; align-items: center; gap: 16rpx; }
.device-icon { font-size: 40rpx; }
.device-name {
  font-size: 32rpx; font-weight: 600; color: #1A2332;
  max-width: 280rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.device-meta { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; }
.arrow-icon {
  font-size: 40rpx; color: #CBD5E0; font-weight: 300;
  width: 48rpx; height: 48rpx;
  background: #F8FAFC; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

/* ===== AQI 大卡片 ===== */
.aqi-card {
  margin: 16rpx 20rpx;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}
.aqi-label { font-size: 26rpx; opacity: 0.9; margin-bottom: 8rpx; }
.aqi-value {
  font-size: 140rpx; font-weight: 700;
  line-height: 1.1;
  text-shadow: 0 2rpx 20rpx rgba(0,0,0,0.1);
}
.aqi-level-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 12rpx;
}
.aqi-level-tag {
  font-size: 28rpx; font-weight: 600;
  background: rgba(255,255,255,0.25);
  padding: 6rpx 24rpx;
  border-radius: 40rpx;
}
.aqi-update { font-size: 22rpx; opacity: 0.75; }

/* ===== 污染物网格 ===== */
.pollutant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin: 16rpx 20rpx;
}
.grid-item {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.grid-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}
.grid-label { font-size: 22rpx; color: #94A3B8; margin-bottom: 6rpx; }
.grid-value {
  font-size: 32rpx; font-weight: 700; color: #1A2332;
  display: flex; align-items: baseline; gap: 4rpx;
}
.grid-unit { font-size: 20rpx; font-weight: 400; color: #94A3B8; }

/* ===== 快捷操作 ===== */
.quick-actions {
  display: flex; gap: 20rpx;
  margin: 16rpx 20rpx;
}
.action-item {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.action-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  margin-bottom: 10rpx;
  color: #fff;
}
.action-text { font-size: 24rpx; color: #64748B; font-weight: 500; }

/* ===== 设备选择弹窗 ===== */
.picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; justify-content: center; align-items: flex-end;
  z-index: 100;
}
.picker-content {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 0 60rpx;
  max-height: 520rpx;
}
.picker-title {
  text-align: center; font-size: 32rpx; font-weight: 700; color: #1A2332;
  padding-bottom: 24rpx; border-bottom: 1rpx solid #F0F4F3;
}
.picker-list { max-height: 320rpx; }
.picker-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
}
.picker-item-active {
  background: #F0FDF4;
}
.picker-item-left { display: flex; align-items: center; gap: 16rpx; }
.picker-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
}
.dot-online { background: #4CAF50; box-shadow: 0 0 6rpx rgba(76,175,80,0.5); }
.dot-offline { background: #CBD5E0; }

.check-mark {
  color: #4CAF50; font-weight: 700; font-size: 36rpx;
  width: 44rpx; height: 44rpx;
  background: #F0FDF4; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.picker-empty { text-align: center; color: #94A3B8; padding: 40rpx; }
.picker-close {
  text-align: center; padding: 24rpx 0 0;
  font-size: 28rpx; color: #94A3B8;
  border-top: 1rpx solid #F0F4F3; margin: 0 40rpx;
}
