/* ===== 设备列表页 ===== */
.page-container { padding-top: 4rpx; }

/* ===== 顶部标题栏 ===== */
.header-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 8rpx;
}
.header-left { display: flex; align-items: baseline; gap: 12rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: #1A2332; }
.header-count { font-size: 24rpx; color: #94A3B8; }
.header-actions { display: flex; gap: 16rpx; }
.header-btn {
  display: flex; align-items: center; gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #F0F4F3;
  color: #64748B;
}
.header-btn-scan {
  background: linear-gradient(135deg, #4CAF50, #43A047);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.25);
}
.header-btn-icon { font-size: 28rpx; line-height: 1; }
.header-btn-text { font-weight: 500; }

/* ===== 分区标签 ===== */
.section-label {
  font-size: 26rpx; color: #94A3B8;
  padding: 24rpx 32rpx 12rpx;
  font-weight: 500;
}

/* ===== 收藏设备横向滚动 ===== */
.fav-scroll {
  white-space: nowrap;
  padding: 0 20rpx 16rpx;
}
.fav-card {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 220rpx;
  height: 140rpx;
  margin: 0 8rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFFDE7, #FFF8E1);
  border: 2rpx solid #FFE082;
  border-radius: 18rpx;
  vertical-align: top;
}
.fav-card-top { display: flex; align-items: center; gap: 8rpx; }
.fav-card-icon { font-size: 28rpx; }
.fav-card-name {
  font-size: 26rpx; font-weight: 600; color: #1A2332;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 150rpx;
}
.fav-card-bottom { display: flex; align-items: center; gap: 6rpx; }
.fav-card-status { font-size: 22rpx; color: #94A3B8; }

/* ===== 设备卡片列表 ===== */
.device-section { padding-bottom: 20rpx; }
.device-card {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff;
  margin: 0 20rpx 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.device-card-left { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.device-card-icon { position: relative; font-size: 40rpx; }
.device-card-dot {
  position: absolute; top: -2rpx; right: -4rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  border: 2rpx solid #fff;
}
.device-card-dot.dot-online { background: #4CAF50; }
.device-card-dot.dot-offline { background: #CBD5E0; }
.device-card-info { flex: 1; overflow: hidden; }
.device-card-name {
  font-size: 30rpx; font-weight: 600; color: #1A2332;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.device-card-id { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; }
.device-card-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.tag-active {
  font-size: 22rpx; color: #4CAF50;
  background: #F0FDF4; padding: 4rpx 16rpx;
  border-radius: 20rpx; font-weight: 500;
}
.device-card-arrow { font-size: 36rpx; color: #CBD5E0; }

/* ===== 空状态 ===== */
.empty-devices {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 0;
}
.empty-devices-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.5; }
.empty-devices-text { font-size: 30rpx; color: #94A3B8; margin-bottom: 8rpx; }
.empty-devices-hint { font-size: 24rpx; color: #CBD5E0; }

/* ===== 输入弹窗 ===== */
.dialog-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.dialog-box {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
}
.dialog-icon {
  width: 80rpx; height: 80rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  margin-bottom: 20rpx;
}
.dialog-title { font-size: 34rpx; font-weight: 700; color: #1A2332; }
.dialog-subtitle { font-size: 26rpx; color: #94A3B8; margin-top: 8rpx; }
.dialog-input {
  margin-top: 32rpx;
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E8ECF0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #F8FAFC;
}
.dialog-input:focus {
  border-color: #4CAF50;
  box-shadow: 0 0 0 4rpx rgba(76,175,80,0.1);
}
.dialog-btns {
  display: flex; gap: 20rpx; margin-top: 40rpx; width: 100%;
}
.dialog-btn {
  flex: 1; height: 80rpx; line-height: 80rpx;
  text-align: center; border-radius: 40rpx; font-size: 30rpx; font-weight: 500;
}
.dialog-btn-cancel { background: #F0F4F3; color: #64748B; }
.dialog-btn-confirm { background: linear-gradient(135deg, #4CAF50, #43A047); color: #fff; box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.3); }
