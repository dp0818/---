<view class="devices-container">
  <!-- 顶部背景 -->
  <view class="devices-header-bg"></view>

  <!-- 头部 -->
  <view class="devices-header">
    <view class="header-title-group">
      <view class="header-title">我的设备</view>
      <view class="header-count" wx:if="{{deviceList.length > 0}}">{{deviceList.length}} 台设备</view>
    </view>
    <view class="header-actions">
      <view class="header-btn" bindtap="showInputDialog">
        <text class="header-btn-icon">✏️</text>
      </view>
      <view class="header-btn header-btn-primary" bindtap="handleScan">
        <text class="header-btn-icon">＋</text>
      </view>
    </view>
  </view>

  <!-- 收藏设备 -->
  <view wx:if="{{favoriteList.length > 0}}" class="fav-section animate-fade-in">
    <view class="section-label">⭐ 收藏设备</view>
    <scroll-view scroll-x class="fav-scroll">
      <view wx:for="{{favoriteList}}" wx:key="device_id"
        class="fav-card" bindtap="goFavDetail"
        data-device-id="{{item.device_id}}" data-device-name="{{item.device_name}}">
        <view class="fav-glow {{item.aqiClass}}"></view>
        <view class="fav-card-top">
          <view class="fav-card-icon">📡</view>
          <view class="fav-status-dot {{item.status === 1 || item.status === 'online' ? 'online' : 'offline'}}"></view>
        </view>
        <view class="fav-card-name">{{item.device_name || item.device_id}}</view>
        <view class="fav-card-aqi {{item.aqiClass}}" wx:if="{{item.latestAqi > 0}}">
          AQI {{item.latestAqi}}
        </view>
        <view class="fav-card-aqi-empty" wx:else>离线</view>
      </view>
    </scroll-view>
  </view>

  <!-- 全部设备 -->
  <view class="device-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-label">{{favoriteList.length > 0 ? '全部设备' : '已绑定设备'}}</text>
    </view>

    <view wx:if="{{deviceList.length > 0}}">
      <view wx:for="{{deviceList}}" wx:key="device_id"
        class="device-card animate-fade-in" style="animation-delay: {{index * 0.05}}s;"
        bindtap="goDetail"
        data-device-id="{{item.device_id}}" data-device-name="{{item.device_name}}">
        <view class="device-card-glow {{item.aqiClass}}"></view>
        <view class="device-card-left">
          <view class="device-icon-wrap">
            <view class="device-icon">📡</view>
            <view class="device-status-ring {{item.status === 1 || item.status === 'online' ? 'online' : 'offline'}}"></view>
          </view>
          <view class="device-info">
            <view class="device-name">{{item.device_name || item.device_id}}</view>
            <view class="device-room" wx:if="{{item.room_location}}">
              <text class="room-icon">{{roomIcons[item.room_location] || '🏠'}}</text>
              <text class="room-name">{{roomNames[item.room_location] || '客厅'}}</text>
            </view>
            <view class="device-id">ID: {{item.device_id}}</view>
          </view>
        </view>
        <view class="device-card-right">
          <view wx:if="{{item.status === 1 || item.status === 'online'}}" class="device-aqi-ring {{item.aqiClass}}">
            <view class="device-aqi-value">{{item.latestAqi > 0 ? item.latestAqi : '--'}}</view>
          </view>
          <view wx:if="{{item.status === 1 || item.status === 'online'}}" class="device-aqi-label {{item.aqiClass}}">{{item.latestAqi > 0 ? (item.levelText || '未知') : '在线'}}</view>
          <view class="device-offline-tag" wx:else>离线</view>
          <view class="device-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{deviceList.length === 0}}" class="empty-devices animate-fade-in">
      <view class="empty-glow"></view>
      <view class="empty-icon">📡</view>
      <view class="empty-text">还没有绑定设备</view>
      <view class="empty-hint">点击右上角扫码或手动输入ID绑定</view>
    </view>

    <!-- 状态检测错误提示 -->
    <view wx:if="{{statusError}}" class="status-error-bar">
      <text class="status-error-icon">⚠️</text>
      <text class="status-error-text">{{statusError}}</text>
    </view>
  </view>

  <view style="height: 60rpx;"></view>

  <!-- 手动输入弹窗 -->
  <view wx:if="{{showDialog}}" class="dialog-overlay" bindtap="hideInputDialog">
    <view class="dialog-box animate-scale-in" catchtap="stopPropagation">
      <view class="dialog-icon-wrap">
        <view class="dialog-icon">🔗</view>
      </view>
      <view class="dialog-title">绑定设备</view>
      <view class="dialog-subtitle">输入设备ID进行绑定</view>
      <input class="dialog-input" placeholder="请输入设备ID" maxlength="50"
        value="{{inputDeviceId}}" bindinput="onInputChange" focus
        placeholder-class="dialog-input-placeholder"/>
      <view class="dialog-btns">
        <view class="dialog-btn dialog-btn-cancel" bindtap="hideInputDialog">取消</view>
        <view class="dialog-btn dialog-btn-confirm" bindtap="handleManualBind">下一步</view>
      </view>
    </view>
  </view>

  <!-- 房间选择弹窗 -->
  <view wx:if="{{showRoomPicker}}" class="dialog-overlay" bindtap="hideRoomPicker">
    <view class="dialog-box animate-scale-in" catchtap="stopPropagation">
      <view class="dialog-icon-wrap" style="background: linear-gradient(135deg, #2196F3, #42A5F5);">
        <view class="dialog-icon">🏠</view>
      </view>
      <view class="dialog-title">选择房间位置</view>
      <view class="dialog-subtitle">设备将绑定到该房间</view>
      <picker mode="selector" range="{{roomOptions}}" range-key="label" value="0" bindchange="onRoomChange">
        <view class="room-picker-value">
          <text class="room-picker-icon">{{selectedRoomIcon}}</text>
          <text class="room-picker-label">{{selectedRoomLabel}}</text>
          <text class="room-picker-arrow">›</text>
        </view>
      </picker>
      <view class="dialog-btns">
        <view class="dialog-btn dialog-btn-cancel" bindtap="hideRoomPicker">取消</view>
        <view class="dialog-btn dialog-btn-confirm" bindtap="confirmRoomBind">确认绑定</view>
      </view>
    </view>
  </view>
</view>
