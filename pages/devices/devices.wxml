<view class="page-container">
  <!-- 顶部标题栏 -->
  <view class="header-bar">
    <view class="header-left">
      <view class="header-title">我的设备</view>
      <view class="header-count" wx:if="{{deviceList.length > 0}}">{{deviceList.length}}台</view>
    </view>
    <view class="header-actions">
      <view class="header-btn" bindtap="showInputDialog">
        <text class="header-btn-icon">✏️</text>
        <text class="header-btn-text">手动绑定</text>
      </view>
      <view class="header-btn header-btn-scan" bindtap="handleScan">
        <text class="header-btn-icon">＋</text>
        <text class="header-btn-text">扫码</text>
      </view>
    </view>
  </view>

  <!-- 手动输入弹窗 -->
  <view wx:if="{{showDialog}}" class="dialog-overlay" bindtap="hideInputDialog">
    <view class="dialog-box" catchtap="stopPropagation">
      <view class="dialog-icon">🔗</view>
      <view class="dialog-title">绑定设备</view>
      <view class="dialog-subtitle">输入设备ID进行绑定</view>
      <input class="dialog-input" placeholder="请输入设备ID" maxlength="50"
        value="{{inputDeviceId}}" bindinput="onInputChange" focus />
      <view class="dialog-btns">
        <view class="dialog-btn dialog-btn-cancel" bindtap="hideInputDialog">取消</view>
        <view class="dialog-btn dialog-btn-confirm" bindtap="handleManualBind">确认绑定</view>
      </view>
    </view>
  </view>

  <!-- 收藏设备 -->
  <view wx:if="{{favoriteList.length > 0}}" class="fav-section">
    <view class="section-label">⭐ 收藏的设备</view>
    <scroll-view scroll-x class="fav-scroll">
      <view wx:for="{{favoriteList}}" wx:key="device_id"
        class="fav-card" bindtap="goFavDetail"
        data-device-id="{{item.device_id}}" data-device-name="{{item.device_name}}">
        <view class="fav-card-top">
          <view class="fav-card-icon">📡</view>
          <view class="fav-card-name">{{item.device_name || item.device_id}}</view>
        </view>
        <view class="fav-card-bottom">
          <view class="status-dot {{item.status === 1 ? 'online' : 'offline'}}"></view>
          <text class="fav-card-status">{{item.status === 1 ? '在线' : '离线'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 全部设备 -->
  <view class="device-section">
    <view class="section-label">{{favoriteList.length > 0 ? '全部设备' : '已绑定的设备'}}</view>
    <view wx:if="{{deviceList.length > 0}}">
      <view wx:for="{{deviceList}}" wx:key="device_id"
        class="device-card" bindtap="goDetail"
        data-device-id="{{item.device_id}}" data-device-name="{{item.device_name}}">
        <view class="device-card-left">
          <view class="device-card-icon">
            <view class="device-card-dot {{item.status === 1 ? 'dot-online' : 'dot-offline'}}"></view>
            📡
          </view>
          <view class="device-card-info">
            <view class="device-card-name">{{item.device_name || item.device_id}}</view>
            <view class="device-card-id">ID: {{item.device_id}}</view>
          </view>
        </view>
        <view class="device-card-right">
          <view wx:if="{{item.status === 1}}" class="tag-active">在线</view>
          <view class="device-card-arrow">›</view>
        </view>
      </view>
    </view>
    <!-- 空状态 -->
    <view wx:if="{{deviceList.length === 0}}" class="empty-devices">
      <view class="empty-devices-icon">📡</view>
      <view class="empty-devices-text">还没有绑定设备</view>
      <view class="empty-devices-hint">点击右上角扫码或手动输入ID绑定</view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
