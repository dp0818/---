/* ===== 全局样式 - 白色+绿色清新风 ===== */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: #F5F7FA;
  color: #333333;
  -webkit-font-smoothing: antialiased;
}

/* 滚动条隐藏 */
::-webkit-scrollbar { display: none; }

/* ===== 通用卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E8ECF0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

/* ===== 通用按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, #4CAF50, #43A047);
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(76,175,80,0.3);
  transition: all 0.3s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.2);
}

/* ===== AQI 颜色等级 ===== */
.aqi-excellent { background: linear-gradient(135deg, #4CAF50, #66BB6A); }
.aqi-good { background: linear-gradient(135deg, #FFC107, #FFD54F); }
.aqi-mild { background: linear-gradient(135deg, #FF9800, #FFB74D); }
.aqi-moderate { background: linear-gradient(135deg, #F44336, #EF5350); }
.aqi-severe { background: linear-gradient(135deg, #9C27B0, #AB47BC); }

/* 文字颜色版 */
.text-excellent { color: #4CAF50; }
.text-good { color: #FFC107; }
.text-mild { color: #FF9800; }
.text-moderate { color: #F44336; }
.text-severe { color: #9C27B0; }

/* ===== 动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-fade-in { animation: fadeIn 0.5s ease forwards; }
.animate-scale-in { animation: scaleIn 0.4s ease forwards; }
.animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

/* ===== 玻璃拟态（浅色版）===== */
.glass {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid #E8ECF0;
}

/* ===== 发光效果 ===== */
.glow-green { box-shadow: 0 0 20rpx rgba(76,175,80,0.25); }
.glow-yellow { box-shadow: 0 0 20rpx rgba(255,193,7,0.25); }
.glow-orange { box-shadow: 0 0 20rpx rgba(255,152,0,0.25); }
.glow-red { box-shadow: 0 0 20rpx rgba(244,67,54,0.25); }
.glow-purple { box-shadow: 0 0 20rpx rgba(156,39,176,0.25); }
